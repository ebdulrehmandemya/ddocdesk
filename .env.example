# .env.example
# Database
POSTGRES_USER=ddocdesk
POSTGRES_PASSWORD=ddocdesk_pass
POSTGRES_DB=ddocdesk
DATABASE_URL=postgresql+asyncpg://ddocdesk:ddocdesk_pass@localhost:5432/ddocdesk

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false

# Qdrant
QDRANT_URL=http://localhost:6333

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_pass

# SMTP (Mailpit for local dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=noreply@ddocdesk.io

# App
APP_URL=http://localhost:3000
INVITATION_EXPIRY_DAYS=7
